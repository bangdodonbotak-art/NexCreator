# NexCreator V5 — env
# Salin ke .env.local (JANGAN commit). Isi di Vercel: Project Settings → Environment Variables.
# Supabase masih INACTIVE/paused — restore dulu di dashboard Supabase,
# lalu jalankan supabase/migrations/20261107000000_v5_init.sql di SQL Editor.

# Supabase (publik, aman di client — keamanan ditegakkan RLS per-user)
NEXT_PUBLIC_SUPABASE_URL=https://obftqgbsrpoonitxjqep.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — server only, JANGAN pakai prefix NEXT_PUBLIC_
# Model produksi: gemini-2.5-flash. Argon (gemini-4-argon) hanya manual via aplikasi Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram — server only
TELEGRAM_BOT_TOKEN=
# Fallback server; per-user diutamakan via profiles.telegram_chat_id
TELEGRAM_CHAT_ID=
